# ---- Required ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
WTC_JWT_SECRET=change-me

# ---- Optional (defaults shown) ----
# WTC_ACCESS_TOKEN_MINUTES=30
# WTC_LOGIN_MAX_FAILURES=5              # per username + client IP
# WTC_LOGIN_MAX_FAILURES_PER_IP=20      # per client IP, any username
# WTC_LOGIN_LOCKOUT_MINUTES=15
# WTC_API_KEY_MAX_DAYS=365

# WTC_USER_DB_PATH=data/users.db
# WTC_WAGE_CODE_MAP_PATH=data/wage_codes.csv
# WTC_JOB_DIR=<system temp>/wage-catalog-jobs

# WTC_MAX_UPLOAD_MB=10                  # per file
# WTC_MAX_PENDING_JOBS_PER_USER=5
# WTC_MAX_CONCURRENT_PROCESSING=4
# WTC_PROCESSING_QUEUE_TIMEOUT_SECONDS=30
# WTC_JOB_TTL_MINUTES=60
# WTC_CLEANUP_INTERVAL_SECONDS=300

# WTC_CORS_ORIGINS=https://app.example.com
# WTC_ENABLE_DOCS=true                  # set false in production if the API must not be self-describing
# WTC_LOG_LEVEL=INFO
# WTC_LOG_FORMAT=text                   # json for log aggregation
